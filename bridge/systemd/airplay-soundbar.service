[Unit]
Description=AirPlay to Samsung soundbar bridge
After=network-online.target avahi-daemon.service nqptp.service
Wants=network-online.target
Requires=avahi-daemon.service
# nqptp provides the PTP clock AirPlay 2 needs. It is absent on an AirPlay 1
# install, so this is Wants (optional) rather than Requires.
Wants=nqptp.service

[Service]
Type=simple
EnvironmentFile=-/etc/airplay-soundbar/bridge.env
ExecStart=/usr/bin/python3 /opt/airplay-soundbar/bridge.py
Restart=always
RestartSec=5

# shairport-sync needs realtime scheduling for glitch-free audio.
LimitRTPRIO=99
LimitMEMLOCK=infinity
Nice=-10

NoNewPrivileges=true
ProtectHome=true
# 'full' rather than 'strict': shairport-sync is a source build under
# /usr/local and needs a writable /tmp for its metadata pipe.
ProtectSystem=full
PrivateTmp=false
ReadWritePaths=/tmp
# 'full' mounts /etc read-only along with /usr and /boot, which stops the web
# panel saving settings: it persists them by rewriting bridge.env, in here.
# Narrowed to the bridge's own directory rather than relaxing ProtectSystem.
# The '-' prefix keeps the service startable if the directory is ever missing;
# saving then fails with a clear message instead of the unit refusing to start.
ReadWritePaths=-/etc/airplay-soundbar
StateDirectory=airplay-soundbar

StandardOutput=journal
StandardError=journal
SyslogIdentifier=airplay-soundbar

[Install]
WantedBy=multi-user.target
